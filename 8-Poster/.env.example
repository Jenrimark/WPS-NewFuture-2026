# =============================================================================
# 灵犀工坊 poster 环境变量示例
# 复制为 .env 后填写真实值；勿将 .env 提交到公开仓库。
# =============================================================================

# ---- 服务 ----
PORT=8080
JWT_SECRET=change-me-to-a-long-random-string
# SQLite 路径（相对 server 工作目录；Docker 内可写 /app/data/poster.db）
# DB_PATH=poster.db

# ---- 阿里云 OSS 直传（GET /api/oss/sts）----
# 使用主账号或 RAM 用户 AK 调用 STS AssumeRole，前端用返回的临时密钥上传。
# （变量名须为下列两项；与部分文档中的 OSS_ACCESS_KEY_* 不同，后端只读 ALIYUN_*）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 需授予 AssumeRole 权限的 RAM 角色 ARN，例如 acs:ram::123456789:role/xxx
ALIYUN_RAM_ROLE_ARN=
# STS 接口地域，默认 cn-hangzhou
# ALIYUN_STS_REGION=cn-hangzhou

# Bucket 与 OSS 地域（region 形如 oss-cn-hangzhou）
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
# 对象键前缀，建议以 / 结尾
# OSS_UPLOAD_PREFIX=poster-uploads/
# 浏览器直传 OSS 时，必须在「该 Bucket」配置跨域 CORS（与 STS、AK 无关）：
# 控制台 → 进入该 Bucket → 左侧「数据安全」→「跨域设置」（或「跨域资源共享」）→ 创建规则
#   来源：每行一个，例如 http://localhost:5173 与 http://127.0.0.1:5173（用 Docker/8080 时再加 8080）
#   允许 Methods：建议全选 GET、POST、PUT、DELETE、HEAD（GET 用于读对象/部分 SDK 行为，PUT 为上传必需）
#   允许 Headers：*
#   暴露 Headers：ETag（可选 x-oss-request-id）
#   缓存时间：可填 600（秒）减轻预检 OPTIONS 频率；填 0 也可
# 未配置时浏览器 PUT 会报 XHR error / status -1。

# ---- 前端字体库（OSS 目录 font-library/，与 manifest.json 同桶）----
# 公网 HTTPS 基址，必须以 / 结尾。需为该 Bucket 配置 CORS（GET）以便拉取 .json 与 .ttf/.woff2。
# 示例（地域 endpoint 以控制台为准）：https://jenrimark-oss.oss-cn-hangzhou.aliyuncs.com/font-library/
# VITE_FONT_LIBRARY_BASE_URL=

# ---- 阿里云百炼文生图（POST /api/ai/generate）----
DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-image-plus
# 一般无需修改；仅代理/自建网关时覆盖
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# 其它可选模型（注释备忘，改 DASHSCOPE_MODEL 即可切换）
# qwen-image
# qwen-mt-image
# qwen-image-plus
# qwen-image-plus-2026-01-09
# qwen-image-edit
# wanx2.1-imageedit
# qwen-image-edit-plus-2025-12-15
# wan2.6-image
# qwen-image-edit-max
# qwen-image-edit-max-2026-01-16
# qwen-image-max
# qwen-image-max-2025-12-30
# wan2.7-image
# wan2.7-image-pro
# qwen-image-2.0
# qwen-image-2.0-2026-03-03
# qwen-image-2.0-pro
# qwen-image-2.0-pro-2026-03-03
# qwen-image-2.0-pro-2026-04-22
