# ---- Merged rules from subdirectory .gitignore ----

# Logs / debug output
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build output
dist
dist-ssr
*.local

# Only allow this specific built output to be tracked
!week03/homework/course/client/dist
!week03/homework/course/client/dist/**


# Don't upload lockfile (keeps diffs noisy)
/week03/homework/course/package-lock.json
/week07/homework/poster/docs
# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- 密钥与本地环境（切勿提交真实 KEY）----
# 忽略所有 .env 文件
.env
# 保留 .env.example 模板文件（不含真实密钥）
!.env.example
# 其他 .env 变体
.env.local
.env.*.local
.env.development
.env.production
# 密钥文件
*.pem
*.key
id_rsa
id_rsa.pub
*.p12
*.pfx

# ---- Go 构建产物 ----
*.test
*.prof
*.coverprofile
coverage.out
coverage.html
vendor/

# ---- 前端 / Node 额外产物 ----
.cache
.parcel-cache
.turbo
.next
.nuxt
.output
.vercel
*.tsbuildinfo
.eslintcache
storybook-static

# ---- Python（若仓库含脚本）----
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
*.egg-info/
.eggs/

# ---- 压缩包与临时文件（减少误传大文件）----
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz
*.bak
*.tmp
*.temp
*~

# ---- 本地编译的 Go 可执行文件（按目录名排除，勿提交）----
**/docker-gin/backend/server