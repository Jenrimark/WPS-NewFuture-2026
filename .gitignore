# 忽略当前目录下的Debug文件
Debug/
Release/
*.obj
x64
.vs/
.vscode
.kiro
/docs
.claude
.cursor
*.exe
/test

# !是不忽略的意思
!*.sln  
!*.vcxproj
!*.filters

#忽略所有.user结尾的文件
*.user

node_modules
typings
npm-debug.log*
