#############################################
# 英语单词学习助手 - 后端环境变量模板
# 用法：
# 1) 复制本文件为 backend/.env
# 2) 按注释填写真实值
# 3) docker-compose 会自动读取 backend/.env
#############################################

# ========= 应用基础配置 =========
APP_PORT=8080
GIN_MODE=release
JWT_SECRET=please_change_this_to_a_long_random_secret

# ========= 数据库配置 =========
# Docker Compose 场景：主机名必须是 db（服务名）
MYSQL_DSN=wordapp:wordapp_pass@tcp(db:3306)/wordapp?charset=utf8mb4&parseTime=true&loc=Local

# ========= AI Provider: DeepSeek =========
# 只配 DeepSeek 也能正常查词
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ========= AI Provider: Qwen（通义千问）=========
# 只配 Qwen 也能正常查词
QWEN_API_KEY=replace_with_your_qwen_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 说明：
# - 至少配置一个可用的 API KEY（DeepSeek 或 Qwen）
# - 如果两个都为空，/api/words/query 会返回 AI_ERROR
