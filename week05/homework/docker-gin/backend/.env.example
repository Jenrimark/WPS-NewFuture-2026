#############################################
# 英语单词学习助手 - 后端环境变量模板
#
# 用法：
#   cp backend/.env.example backend/.env
#   编辑 backend/.env 填入真实密钥（勿提交 .env 到 Git）
#
# 安全：切勿在 README、聊天、截图中粘贴真实 API Key；
#       密钥一旦泄露，请立即在云控制台作废并轮换。
#############################################

# ========= 应用基础配置 =========
APP_PORT=8080
GIN_MODE=release
JWT_SECRET=please_change_this_to_a_long_random_secret

# ========= 数据库（Docker Compose 内联调）=========
# 主机名必须是服务名 db
MYSQL_DSN=wordapp:wordapp_pass@tcp(db:3306)/wordapp?charset=utf8mb4&parseTime=true&loc=Local

# ========= 主用：阿里云 DashScope（通义千问，OpenAI 兼容模式）=========
# 控制台与文档见阿里云「灵积模型服务」；兼容模式 Base URL 一般为：
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 常用模型示例：qwen-plus / qwen-turbo（以控制台为准）
QWEN_MODEL=qwen-plus
# 将下方替换为你的 DashScope API Key（通常以 sk- 开头）
QWEN_API_KEY=replace_with_your_dashscope_api_key

# ========= 可选：第二套 OpenAI 兼容 Chat Completions 接口 ==========
# 不配也可运行：查词时前端只选「阿里云通义千问」即可。
# 若填写 DEEPSEEK_API_KEY，则前端「备用线路」可用（请求参数 ai_provider=deepseek，仅为代码历史命名）。
# BASE_URL / MODEL 不配时使用程序内默认值；若你的备用厂商不同，请改成对方文档中的地址与模型名。
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL=
